# Copy to .env and adjust. Never commit .env, private keys, or real credentials.
#
# docker compose reads POSTGRES_*, AUTH_PREVIOUS_PUBLIC_KEYS, JWT_EXPIRATION_MS,
# AUTH_REGISTRATION_ENABLED, and AUTH_RATE_LIMIT_MAX_ATTEMPTS from this file. The signing key
# comes from the Docker secret file secrets/auth-signing-key.pem, so leave AUTH_SIGNING_KEY empty
# for compose. The SPRING_DATASOURCE_* and AUTH_SIGNING_* variables below are for running the jar
# directly on the host.

# Released authBuddy version that production runs (docker-compose.yml pulls
# ghcr.io/rtcryo/authbuddy-auth-service:<version>). Required. Updated by release-please.
AUTHBUDDY_VERSION=1.0.0 # x-release-please-version

# PostgreSQL (database `authbuddy`)
POSTGRES_DB=authbuddy
POSTGRES_USER=authbuddy
POSTGRES_PASSWORD=change-me

# auth-service datasource (local run on host port 5434, see the root port registry)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/authbuddy
SPRING_DATASOURCE_USERNAME=authbuddy
SPRING_DATASOURCE_PASSWORD=change-me

# Token signing (required; the service refuses to start without a valid key).
# Current RSA private key, PKCS#8 PEM (BEGIN PRIVATE KEY), at least 2048 bits. Use literal \n
# for line breaks, or leave empty and mount the key file and set AUTH_SIGNING_KEY_FILE.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
AUTH_SIGNING_KEY=
AUTH_SIGNING_KEY_FILE=
# Public keys (X.509 PEM, \n for line breaks, comma separated) kept in the JWKS after a rotation.
AUTH_PREVIOUS_PUBLIC_KEYS=
# Token lifetime in milliseconds (default 24 h).
JWT_EXPIRATION_MS=86400000

# Set to false during the finanzBuddy migration until the legacy import and the finanzBuddy
# switch are done, so nobody can claim an existing finanzBuddy email first.
AUTH_REGISTRATION_ENABLED=true
# Sign-in and registration attempts allowed per minute, separately per client IP and per email.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
